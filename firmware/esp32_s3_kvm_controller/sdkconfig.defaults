# ===== Flash =====
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"

# ===== 关闭 USB Serial/JTAG，释放 GPIO19/20 给 USB OTG =====
CONFIG_USJ_ENABLE_USB_SERIAL_JTAG=n

# ===== 次级控制台不使用 USB Serial/JTAG =====
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# ===== TinyUSB：键鼠两个 HID 实例（Interface 0 键盘 boot、Interface 1 鼠标非 boot）=====
CONFIG_TINYUSB_HID_COUNT=2
# ===== TinyUSB CDC：Interface 2 = Comm，Interface 3 = Data =====
# EP_BUFSIZE 必须显式设为 64：全速 Bulk 端点最大包长为 64，默认 512 与之冲突
CONFIG_TINYUSB_CDC_ENABLED=y
CONFIG_TINYUSB_CDC_COUNT=1
CONFIG_TINYUSB_CDC_RX_BUFSIZE=512
CONFIG_TINYUSB_CDC_TX_BUFSIZE=512
CONFIG_TINYUSB_CDC_EP_BUFSIZE=64
